#!/bin/bash
#
# Update the Homebrew Cask formula with SHA256 hashes from a GitHub release.
# Usage: ./script/update-homebrew-cask v0.1.0
#
set -euo pipefail

VERSION="${1:?Usage: $0 <version-tag>}"
VERSION_NUM="${VERSION#v}"
REPO="JMrtzsn/warpdrive"
TAP_REPO="Johannes-IKEA/homebrew-warpdrive"

echo "==> Fetching SHA256 for release $VERSION"

ARM_URL="https://github.com/$REPO/releases/download/$VERSION/Warpdrive-macos-arm64.zip"
X86_URL="https://github.com/$REPO/releases/download/$VERSION/Warpdrive-macos-x86_64.zip"

ARM_SHA=$(curl -sL "$ARM_URL" | shasum -a 256 | cut -d' ' -f1)
X86_SHA=$(curl -sL "$X86_URL" | shasum -a 256 | cut -d' ' -f1)

echo "  arm64:  $ARM_SHA"
echo "  x86_64: $X86_SHA"

CASK_CONTENT=$(cat <<EOF
cask "warpdrive" do
  arch arm: "arm64", intel: "x86_64"

  version "$VERSION_NUM"
  sha256 arm:   "$ARM_SHA",
         intel: "$X86_SHA"

  url "https://github.com/$REPO/releases/download/v#{version}/Warpdrive-macos-#{arch}.zip"
  name "Warpdrive"
  desc "Warp terminal with local AI via OpenCode - no account, no cloud"
  homepage "https://github.com/$REPO"

  depends_on macos: ">= :mojave"

  app "WarpOss.app", target: "Warpdrive.app"

  zap trash: [
    "~/Library/Application Support/dev.warp.WarpOss",
    "~/Library/Caches/dev.warp.WarpOss",
    "~/Library/Preferences/dev.warp.WarpOss.plist",
  ]
end
EOF
)

echo "==> Updating Cask in $TAP_REPO"

# Get current file SHA for the API update
FILE_SHA=$(gh api "repos/$TAP_REPO/contents/Casks/warpdrive.rb" --jq .sha)

gh api "repos/$TAP_REPO/contents/Casks/warpdrive.rb" \
  -X PUT \
  -f message="Update warpdrive to $VERSION" \
  -f content="$(echo "$CASK_CONTENT" | base64)" \
  -f sha="$FILE_SHA" \
  --silent

echo "==> Done. Users can now: brew upgrade --cask warpdrive"
