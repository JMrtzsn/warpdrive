#!/bin/bash
#
# Update the Homebrew Cask formula with SHA256 hash from a GitHub release.
# Usage: ./script/update-homebrew-cask v0.2.0
#
# NOTE: The release must be published (not draft) for download URLs to work.
# Go to GitHub and publish the draft release first.
#
set -euo pipefail

VERSION="${1:?Usage: $0 <version-tag>}"
VERSION_NUM="${VERSION#v}"
REPO="${GITHUB_REPOSITORY:-JMrtzsn/warpdrive}"
TAP_REPO="JMrtzsn/homebrew-warpdrive"

echo "==> Fetching SHA256 for release $VERSION"

ARM_URL="https://github.com/$REPO/releases/download/$VERSION/Warpdrive-macos-arm64.zip"
ARM_SHA=$(curl -sfL "$ARM_URL" | shasum -a 256 | cut -d' ' -f1)

if [[ -z "$ARM_SHA" || "$ARM_SHA" == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" ]]; then
  echo "ERROR: Could not download release asset. Is the release published (not draft)?" >&2
  echo "  URL: $ARM_URL" >&2
  exit 1
fi

echo "  arm64: $ARM_SHA"

CASK_CONTENT=$(cat <<EOF
cask "warpdrive" do
  version "$VERSION_NUM"
  sha256 "$ARM_SHA"

  url "https://github.com/$REPO/releases/download/v#{version}/Warpdrive-macos-arm64.zip"
  name "Warpdrive"
  desc "Warp terminal with local AI via OpenCode - no account, no cloud"
  homepage "https://github.com/$REPO"

  depends_on macos: ">= :mojave"
  depends_on arch: :arm64

  app "Warpdrive.app"

  zap trash: [
    "~/Library/Application Support/dev.warpdrive.Warpdrive",
    "~/Library/Caches/dev.warpdrive.Warpdrive",
    "~/Library/Preferences/dev.warpdrive.Warpdrive.plist",
  ]
end
EOF
)

echo "==> Updating Cask in $TAP_REPO"

# Get current file SHA for the API update
FILE_SHA=$(gh api "repos/$TAP_REPO/contents/Casks/warpdrive.rb" --jq .sha)

gh api "repos/$TAP_REPO/contents/Casks/warpdrive.rb" \
  -X PUT \
  -f message="Update warpdrive to $VERSION" \
  -f content="$(echo "$CASK_CONTENT" | base64)" \
  -f sha="$FILE_SHA" \
  --silent

echo "==> Done. Users can now: brew upgrade --cask warpdrive"
